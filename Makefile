# =====================================================================
#  X68000 Cross-Build Settings
# =====================================================================
CC      = m68k-xelf-gcc
CFLAGS  = -g -O2 -DPATH_MAX=1024
LDFLAGS = -g

# elf2x68k.py のパス自動判定
ifeq ($(wildcard /opt/homebrew/bin/elf2x68k.py),)
    ELF2X68 = python3 /usr/local/bin/elf2x68k.py
else
    ELF2X68 = python3 /opt/homebrew/bin/elf2x68k.py
endif

# 成果物は X68000 の実行ファイル (.x)
LHEXE		= lhdump.x lhasm.x lhcom.x lhpoke.x
LHDUMPSRC	= lhdump.c lh5801.c lhbasic.c lhfrag.c lhsym.c lhunasm.c lhce158hdr.c \
		  version.c
LHASMSRC	= lhasm.c lh5801.c lhbasic.c lhsym.c lhfrag.c lhce158hdr.c \
		  version.c
LHCOMSRC	= lhcom.c lhsym.c lhce158hdr.c version.c
LHPOKESRC	= lhpoke.c lhsym.c lhce158hdr.c version.c

LHDUMPOBJ	= $(LHDUMPSRC:%.c=%.o)
LHASMOBJ	= $(LHASMSRC:%.c=%.o)
LHCOMOBJ	= $(LHCOMSRC:%.c=%.o)
LHPOKEOBJ	= $(LHPOKESRC:%.c=%.o)

LHEXE_WIN32	= lhdump_win32.exe lhasm_win32.exe lhcom_win32.exe lhpoke_win32.exe
LHDUMPOBJ_WIN32	= $(LHDUMPSRC:%.c=%.win32.o)
LHASMOBJ_WIN32	= $(LHASMSRC:%.c=%.win32.o)
LHCOMOBJ_WIN32	= $(LHCOMSRC:%.c=%.win32.o)
LHPOKEOBJ_WIN32	= $(LHPOKESRC:%.c=%.win32.o)


all:		.depend $(LHEXE)

win32:		.depend $(LHEXE_WIN32)

# =====================================================================
#  X68k Build Rules (.o -> .elf -> .x)
# =====================================================================
lhdump.x: lhdump.elf
lhasm.x:  lhasm.elf
lhcom.x:  lhcom.elf
lhpoke.x: lhpoke.elf

lhdump.elf: $(LHDUMPOBJ)
	$(CC) $(LDFLAGS) -o $@ $(LHDUMPOBJ)

lhasm.elf: $(LHASMOBJ)
	$(CC) $(LDFLAGS) -o $@ $(LHASMOBJ)

lhcom.elf: $(LHCOMOBJ)
	$(CC) $(LDFLAGS) -o $@ $(LHCOMOBJ)

lhpoke.elf: $(LHPOKEOBJ)
	$(CC) $(LDFLAGS) -o $@ $(LHPOKEOBJ)

# .elf から .x へ変換する共通パターンルール
%.x: %.elf
	$(ELF2X68) -s -o $@ $<
	@echo "-> 成功: $@ が正常に生成されました！"

# =====================================================================
#  Win32 Build Rules (従来通り)
# =====================================================================
lhdump_win32.exe:	$(LHDUMPOBJ_WIN32)
	$(WIN32CC) $(LDFLAGS) -o $@ $(LHDUMPOBJ_WIN32)

lhasm_win32.exe:	$(LHASMOBJ_WIN32)
	$(WIN32CC) $(LDFLAGS) -o $@ $(LHASMOBJ_WIN32)

lhcom_win32.exe:	$(LHCOMOBJ_WIN32)
	$(WIN32CC) $(LDFLAGS) -o $@ $(LHCOMOBJ_WIN32)

lhpoke_win32.exe:	$(LHPOKEOBJ_WIN32)
	$(WIN32CC) $(LDFLAGS) -o $@ $(LHPOKEOBJ_WIN32)

VERSION = version.c

LHTOOLS = lhTools

LHEXEMAN = $(LHEXE:%=%.1)

TARGETS = $(LHEXE)

SOURCES = $(LHDUMPSRC) $(LHASMSRC) \
	  $(VERSION)

MISC    = COPYING README INSTALL

OBJECTS = $(SOURCES:%.c=%.o)

TARDIR  := ..

INSTALLDIR      := $(HOME)/

LHTOOLSDIR	= share/$(LHTOOLS)
LHTOOLSMISC     = COPYING README
LHTOOLSPDF	= $(LHTOOLS).pdf

BINDIR  := bin/

MANDIR  := man/man1/

INSTALL = $(TARGETS)

.SUFFIXES:	.c .o .win32.o
.c.o:
	$(CC) -c $(CFLAGS) -o $@ $<

.c.win32.o:
	$(WIN32CC) -c $(CFLAGS) -o $@ $<

all:	.depend $(TARGETS)

tests:
	@echo "Running lhTools tests suite..."
	@(cd asm; $(MAKE) SHELL=/bin/bash clean)
	@(cd asm; $(MAKE) SHELL=/bin/bash LSTFILE=yes)
	@(cd asm; $(MAKE) SHELL=/bin/bash clean)

clean-tests:
	@(cd asm; $(MAKE) clean)

clean:	clean-tests
	@echo "Cleaning $(LHTOOLS)"
	@\rm -f $(LHEXE) *.elf $(LHDUMPOBJ) $(LHASMOBJ) $(LHCOMOBJ) $(LHPOKEOBJ)
	@\rm -f $(LHEXE_WIN32) $(LHDUMPOBJ_WIN32) $(LHASMOBJ_WIN32) \
		$(LHCOMOBJ_WIN32) $(LHPOKEOBJ_WIN32)

clean-all:	clean
	@echo "Cleaning all $(LHTOOLS)"
	@\rm -f .depend $(VERSION)

clean-tarball:	clean-all

clean-version distclean:	clean-tarball
	@echo "Cleaning version $(LHTOOLS)"
	@\rm -f VERSION PATCHLEVEL

$(VERSION):	VERSION PATCHLEVEL Makefile
	@( echo "$(LHTOOLS) - Version 0.7.8-x68k-1" )
	@( echo '// This is file is generated by Makefile - DO NOT EDIT' ; \
	   echo '// ===================================================' ; \
	   echo ; \
	   echo 'const char const $(LHTOOLS)_vers[] = "0.7.8-x68k-1";' ; \
	   echo 'const char const $(LHTOOLS)_date[] = "Compiled by Kenoh on '`date +'%Y-%m-%d %H:%M:%S'`'";' ; \
	   echo 'const char const $(LHTOOLS)_pltf[] = "Platform: X68000 (Human68k)";' ; \
	   echo ) > $@

VERSION:	 PATCHLEVEL
	@echo "0.7.8" > $@

PATCHLEVEL:
	@( test -e VERSION || touch VERSION )
	@( test "`basename $(PWD) | sed 's/^.*-//'`" != "`cat VERSION`" && rm -f VERSION )
	@( echo 0 ) > $@

install:	$(TARGETS)
	@echo "Installing $(LHEXE) in $(INSTALLDIR)/$(BINDIR)"
	@chmod 755 $(LHEXE)
	@test -d $(INSTALLDIR)/$(BINDIR) || mkdir -p $(INSTALLDIR)/$(BINDIR)
	@cp -a $(LHEXE) $(INSTALLDIR)/$(BINDIR)
	@echo "Installing manual and others files in $(INSTALLDIR)/$(LHTOOLSDIR)"
	@test -d $(INSTALLDIR)/$(LHTOOLSDIR) || mkdir -p $(INSTALLDIR)/$(LHTOOLSDIR)
	@cp -a $(LHTOOLSMISC) $(LHTOOLSPDF) $(INSTALLDIR)/$(LHTOOLSDIR)

tarball:	VERSION
	@$(MAKE) clean-tarball
	@( TARBALL=`basename $(PWD)` ; \
	   PATCHLVL=`cat PATCHLEVEL` ; \
	   echo "Building tarball $(TARDIR)/$${TARBALL}_$$PATCHLVL.tgz" ; \
	   ( tar -C .. -zcf $(TARDIR)/$${TARBALL}_$$PATCHLVL.tgz $$TARBALL/ ; \
	     chmod 444 $(TARDIR)/$${TARBALL}_$$PATCHLVL.tgz ; \
	     \ls -l $(TARDIR)/$${TARBALL}_$$PATCHLVL.tgz ) ; \
	   echo $$((PATCHLVL + 1)) >PATCHLEVEL )

release:	VERSION
	echo "Closing version lhTools `cat VERSION` #`cat PATCHLEVEL`"
	( echo "`cat VERSION` #`cat PATCHLEVEL`" ; echo "('$(USER)@`hostname`') '`date `" )>.tmp.TARBALL
	$(MAKE) tarball
	echo "Opening new version"
	( VERS=`cat VERSION | \
	    awk 'BEGIN{ FS="." }{ tn=$$3 ; if ($$tn == "") tn=0 ; printf("%u.%u.%u\n", $$1,$$2 + 1,0) }'`; \
	    echo $$VERS; \
	    cp -a $(PWD)/. ../lhTools-$$VERS ; \
	    echo "RELEASE" >../lhTools-$$VERS/PATCHLEVEL ; \
	    rm -f .tmp.TARBALL ; \
	    (cd ../lhTools-$$VERS; \
	       mv .tmp.TARBALL .TARBALL; \
	       make clean-version ; \
	       echo "RELEASE" >PATCHLEVEL; \
	       $(MAKE) VERSION ) )

.depend:	Makefile $(VERSION) $(PATCHLEVEL)
	@touch $@
	@$(CC) -I. -MM $(CFLAGS) $(SOURCES) > $@

include .depend
